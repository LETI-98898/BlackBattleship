          "comment": "Verifica que é apresentado o texto das regras do jogo",
          "command": "assertText",
          "target": "css=div:nth-child(1) > p:nth-child(3)",
          "targets": [
            [
              "css=div:nth-child(1) > p:nth-child(3)",
              "css:finder"
